# Copy to .env and edit. All settings are environment variables; a YAML file
# can be layered underneath with CT_CONFIG=/path/config.yaml (env wins).

# HTTP/WSS listen address.
CT_LISTEN=:8080

# TLS: either a certificate pair ...
#CT_TLS_CERT=/etc/ctserver/fullchain.pem
#CT_TLS_KEY=/etc/ctserver/privkey.pem
# ... or ACME (Let's Encrypt). Requires port 80 reachable for HTTP-01 and
# CT_LISTEN=:443. Certificates are cached under CT_ACME_CACHE_DIR.
#CT_ACME_DOMAIN=transfer.example.com
#CT_ACME_CACHE_DIR=/var/lib/ctserver/acme

# Optional HTTPS download page shown on take-code landing pages.
#CT_DOWNLOAD_URL=https://downloads.example.com/crosstransfer
# Fixed .well-known association JSON files generated by tools/configure_*.
# Mount this directory read-only into the container before setting it.
#CT_ASSOCIATION_DIR=/etc/ctserver/associations

# Publisher notification console at /admin/. Disabled unless a token is set.
# Generate a separate secret with: openssl rand -hex 32
# Use HTTPS for all non-loopback admin access; never reuse the TURN secret.
#CT_ADMIN_TOKEN=
# Default for direct runs: notifications.json; Compose uses the data volume.
#CT_NOTIFICATION_FILE=/var/lib/ctserver/data/notifications.json

# Public IP advertised to clients for STUN/TURN (required when embedded TURN is on).
CT_PUBLIC_IP=203.0.113.10

# Embedded TURN (pion/turn). Set CT_TURN_PORT=0 to disable, or point clients at
# an external coturn with CT_EXTERNAL_TURN=turn:turn.example.com:3478?transport=udp
# (coturn must use the same static-auth-secret as CT_TURN_SECRET).
CT_TURN_PORT=3478
CT_TURN_PORT_RANGE=49152-65535
CT_TURN_SECRET=change-me-to-a-long-random-string
#CT_TURN_REALM=crosstransfer
#CT_TURN_CRED_TTL=10m
# Private/loopback/CGNAT TURN targets are blocked by default. Controlled LAN/tests only:
#CT_TURN_ALLOW_PRIVATE_PEERS=false
#CT_EXTERNAL_TURN=

# Optional extra STUN servers (comma separated). Default: CT_PUBLIC_IP:CT_TURN_PORT.
#CT_STUN_SERVERS=stun.l.google.com:19302

# Resource caps (positive values; excess connections/allocations are rejected).
#CT_MAX_CONNECTIONS=1024
#CT_MAX_CONNECTIONS_PER_IP=32
#CT_MAX_SESSIONS=4096
#CT_MAX_SESSIONS_PER_PEER=64
#CT_TURN_MAX_ALLOCATIONS=512

# UDP relay payload budgets, both directions combined (0 = explicitly unlimited).
#CT_TURN_RATE_LIMIT=8388608
#CT_TURN_GLOBAL_RATE_LIMIT=67108864

# WebSocket relay fallback: per-connection and total payload bytes/sec.
# These budgets are independent from TURN, and 0 explicitly disables one.
CT_RELAY_RATE_LIMIT=8388608
#CT_RELAY_GLOBAL_RATE_LIMIT=67108864

# Take-code claim rate limits.
#CT_CLAIM_RATE_PER_IP=1
#CT_CLAIM_BURST_PER_IP=5
#CT_CLAIM_RATE_GLOBAL=200
#CT_CLAIM_BURST_GLOBAL=400
#CT_CLAIM_FAIL_DELAY=500ms

# Share lifetimes.
#CT_DEFAULT_SHARE_TTL=10m
#CT_MAX_ONCE_TTL=24h
#CT_MAX_OPEN_TTL=24h

# Misc.
#CT_HEARTBEAT_SEC=30
#CT_MAX_MESSAGE_SIZE=1048576
#CT_METRICS=true
#CT_LOG_LEVEL=info
#CT_LOG_JSON=false
# Set to 1 when behind a reverse proxy that sets X-Forwarded-For.
#CT_TRUST_PROXY=0
